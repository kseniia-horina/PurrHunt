    <!-- Onboarding -->
    <string name="onb_title_1">How to leave the game</string>
    <string name="onb_text_1">The game screen has no buttons, so your cat can\'t press anything. To pause, hold a finger in the top right corner for 3 seconds, or hold three fingers on the screen for 2 seconds.</string>
    <string name="onb_title_2">Protect the screen</string>
    <string name="onb_text_2">Claws can scratch the display. A tempered glass screen protector keeps your device safe, and trimmed claws help too.</string>
    <string name="onb_title_3">Short hunts, happy ending</string>
    <string name="onb_text_3">Play 5–15 minutes at a time. Finish every hunt with a real treat so your cat feels the chase ended with prey.</string>
